# App mode. Use "demo" locally without secrets, "staging" for Supabase staging, and "production" only with real providers configured.
DISPLYFY_PROVIDER_MODE=demo

# Public site URL used for links and metadata.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase browser-safe values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase value. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional transactional email provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional Twilio SMS and Verify provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# Optional future Instagram Graph API integration.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Required in production for invitation hashing.
INVITATION_TOKEN_PEPPER=
